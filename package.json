{
  "name": "indiana-expunge",
  "version": "1.0.0",
  "description": "**Automated in-browser MyCase scraper and court-ready expungement packet generator for Indiana's Second Chance Law (Indiana Code § 35-38-9).**",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "i18n": "node scripts/build-i18n.js",
    "test:parity": "node scripts/check-parity.js",
    "test": "npm run i18n && jest && npm run test:parity",
    "test:canary": "node scripts/canary/run-canary.js"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CambrianMinds/indiana-expungement-assistant.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/CambrianMinds/indiana-expungement-assistant/issues"
  },
  "homepage": "https://github.com/CambrianMinds/indiana-expungement-assistant#readme",
  "devDependencies": {
    "jest": "^30.5.1",
    "playwright": "^1.63.0",
    "zod": "^4.5.4"
  }
}
